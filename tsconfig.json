{
  "include": ["**/*.ts", "**/*.tsx", "eslint.config.js", "vite.config.js"],

  "compilerOptions": {
    "target": "es2024",
    "jsx": "react-jsx",
    "module": "esnext",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
